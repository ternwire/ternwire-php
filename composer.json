{
  "name": "ternwire/ternwire",
  "description": "PHP client for the Ternwire transactional email API",
  "type": "library",
  "homepage": "https://ternwire.com",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-hash": "*"
  },
  "autoload": {
    "psr-4": { "Ternwire\\": "src/" }
  },
  "archive": { "exclude": ["/examples", "/vendor"] }
}
